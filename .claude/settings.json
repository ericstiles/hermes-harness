{
  "permissions": {
    "allow": [
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git push -u origin HEAD:refs/heads/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list)",
      "Bash(gh pr list *)",
      "Bash(tests/run_tests.sh)"
    ],
    "deny": [
      "Bash(git push *refs/heads/main)",
      "Bash(git push *refs/heads/main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push -f*)",
      "Bash(git push --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * --force*)",
      "Bash(git push *+*)",
      "Bash(gh pr merge *--admin*)",
      "Bash(gh pr merge *--squash*)",
      "Bash(gh pr merge *--merge*)",
      "Bash(gh pr merge *--auto*)",
      "Bash(gh pr merge * -s*)",
      "Bash(gh pr merge * -m*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "f=\"$(git rev-parse --show-toplevel 2>/dev/null)/.claude/hooks/gh_merge_guard.py\"; [ -f \"$f\" ] || f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/gh_merge_guard.py\"; exec python3 \"$f\"",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  }
}
