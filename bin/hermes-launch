#!/usr/bin/env bash
# hermes-launch — start hermes-run for the CURRENT repo in a herdr tab named
# "hermes-run" (fallback: detached tmux session "hermes-run"). Refuses if a run
# is active anywhere (one local model, one run at a time).
#
# Usage: cd /path/to/target-repo && hermes-launch [--clean] [--timeout 120m] [--reason CLASS] [--issue ID] [--max N] [--dry-run]
# Needs GH_TOKEN in the environment (direnv loads the repo's .envrc.local).
# GITHUB_REPO is optional: hermes-run defaults it to the origin remote.
# The token is never written to a file or printed.
set -uo pipefail
# Resolve symlinks (hermes-* are symlinked onto PATH), then locate the harness.
_s=${BASH_SOURCE[0]}
while [ -h "$_s" ]; do _d=$(cd "$(dirname "$_s")" && pwd); _s=$(readlink "$_s"); case $_s in /*) ;; *) _s="$_d/$_s" ;; esac; done
HARNESS_HOME=$(cd "$(dirname "$_s")/.." && pwd)
# shellcheck source=../lib/common.sh
. "$HARNESS_HOME/lib/common.sh"

usage() {
  cat <<'EOF'
hermes-launch - start an unattended Hermes run over the current repo's beads queue

Usage:
  cd /path/to/target-repo && hermes-launch [options]
  HERMES_REPO=/path/to/target-repo hermes-launch [options]

Options:
  --timeout DURATION  per-run time limit passed to hermes-run as RUN_TIMEOUT (a run
                      still making progress is extended: HERMES_EXTEND, HERMES_EXTEND_CAP)
                      (e.g. 120m). Default: hermes-run's own default, 90m.
  --max N             stop after N issues (default 10). Each issue is one
                      Hermes run, one PR.
  --reason CLASS      why this launch happens; recorded in the relaunch log
                      (default: manual). hermes-supervise passes TIMEOUT,
                      SANDBOX_DOWN, BEADS_SYNC_ERROR or MODEL_API_ERROR.
  --issue ID          beads issue this relaunch is for; recorded with --reason
                      so hermes-supervise can enforce its 3-per-issue-per-day
                      limit (default: unknown).
  --clean             start fresh: hermes-run resets the sandbox's clone of the
                      repo (/workspace/<name> in the Docker container) to
                      origin/main before the first run. Uncommitted work left
                      there by a stopped run is saved first to
                      <repo>/logs/sandbox-dirty-<stamp>.patch. The container,
                      other repos and ignored files (.venv) are not touched.
  --dry-run           print the command that would run and exit; starts
                      nothing and writes nothing.
  -h, --help          show this help and exit. Needs no repo and no GH_TOKEN.

WHAT HAPPENS
  1. Finds the target repo: $HERMES_REPO if set, else the git toplevel of the
     current directory. Stops with an error if neither is a git repo.
  2. Works out GITHUB_REPO (owner/name): the environment value if set, else
     parsed from the repo's origin remote.
  3. Checks every prerequisite and refuses to start (exit 1), listing ALL
     problems at once, if any is missing. --dry-run runs the same checks, so a
     dry run fails exactly when a real launch would:
       - GITHUB_REPO unknown (no env value and no origin remote)
       - GH_TOKEN not set. Load it with direnv from the repo's .envrc.local.
         The token is never written to a file, printed, or put on a command line.
       - a hermes-run or "hermes chat" process already running in ANY repo
         (one local model, so one run at a time)
  4. Creates <repo>/logs and appends one line "YYYYMMDD REASON ISSUE" to
     <repo>/logs/.relaunches (the relaunch counter hermes-supervise reads).
  5. Opens a new herdr tab named "hermes-run" in the current workspace, with
     its working directory set to the repo, and types this into it:
         cd '<repo>' && GITHUB_REPO='<owner/name>' [RUN_TIMEOUT=..] '<harness>/bin/hermes-run' N
     If herdr is not usable it falls back to a detached tmux session named
     "hermes-run" (attach with: tmux attach -t hermes-run). If neither works
     it exits 1.
  6. Returns immediately. The run continues in the tab; hermes-launch does not
     wait. The tab's shell loads direnv, so GH_TOKEN reaches hermes-run there.

  hermes-run then works the queue: for each issue it starts Hermes in the Docker
  sandbox, which claims the issue, implements it with tests, and opens a PR.
  It never merges. The run ends on an empty queue, a blocked issue, a failure
  or a timeout, and writes RUN_RESULT=<CLASS> at the end of its log
  (<repo>/logs/run-*.log). Check on it with hermes-status or hermes-supervise.

ENVIRONMENT
  GH_TOKEN       required. Fine-grained token for the target repo only.
  GITHUB_REPO    owner/name. Optional if the repo has an origin remote (it is
                 parsed from it); required otherwise. Set it if origin is a fork.
  HERMES_REPO    optional path of the target repo instead of the current dir.
  HERMES_LOG_DIR optional; default <repo>/logs.
  RUN_TIMEOUT    optional; --timeout overrides it. Other hermes-run settings
                 (HERMES_ARGS, HERMES_RETRY_ON_TIMEOUT, ...) are inherited
                 only if exported in the tab's shell, not by this command.

EXIT STATUS
  0  started (or --dry-run, or --help)
  1  not started: GITHUB_REPO unknown, no GH_TOKEN, a run is already
     active, or no herdr/tmux
  2  bad usage: unknown option, or not inside a git repo

EXAMPLES
  hermes-launch --dry-run                     see exactly what would start
  hermes-launch                               up to 10 issues, 90m per run
  hermes-launch --timeout 120m --max 3        longer runs, at most 3 issues
  hermes-launch --clean                       reset the sandbox clone first, then run
  hermes-launch --reason TIMEOUT --issue proj-abc --timeout 120m
  HERMES_REPO=~/repo/other hermes-launch      from any directory
EOF
}
for _a in "$@"; do case "$_a" in -h|--help) usage; exit 0 ;; esac; done

hh_repo || exit 2
TO=""; REASON=manual; ISSUE=unknown; MAX=10; DRY=0; CLEAN=""
while [ $# -gt 0 ]; do
  case "$1" in
    --clean)   CLEAN="--clean "; shift ;;
    --timeout) TO=${2:?}; shift 2 ;;
    --reason)  REASON=${2:?}; shift 2 ;;
    --issue)   ISSUE=${2:?}; shift 2 ;;
    --max)     MAX=${2:?}; shift 2 ;;
    --dry-run) DRY=1; shift ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done
# Check every prerequisite and report ALL problems at once, in --dry-run too, so a
# dry run fails exactly when a real launch would.
problems=""
hh_github_repo || problems="$problems
  - GITHUB_REPO is not set and $REPO_ROOT has no origin remote to read it from.
    Fix: export GITHUB_REPO=owner/name   (or: git remote add origin <url>)"
[ -n "${GH_TOKEN:-}" ] || problems="$problems
  - GH_TOKEN is not set (run: direnv allow, or export it)."
if ps -axo command | grep -E "$HH_ACTIVE_PATTERN" | grep -v grep | grep -qv hermes-launch; then
  problems="$problems
  - A hermes-run / hermes chat process is already running (one run at a time)."
fi
if [ -n "$problems" ]; then
  echo "Not starting. Missing or blocking:$problems" >&2; exit 1
fi
# Absolute path to hermes-run so the new tab's shell does not depend on PATH.
cmd="cd '$REPO_ROOT' && GITHUB_REPO='$GITHUB_REPO' ${TO:+RUN_TIMEOUT='$TO'} '$HARNESS_HOME/bin/hermes-run' $CLEAN$MAX"
if [ "$DRY" = 1 ]; then echo "DRY RUN: would start in herdr/tmux tab hermes-run: $cmd"; exit 0; fi
mkdir -p "$LOG_DIR"
printf '%s %s %s\n' "$(date +%Y%m%d)" "$REASON" "$ISSUE" >> "$LOG_DIR/.relaunches"
if command -v herdr >/dev/null 2>&1 && herdr status >/dev/null 2>&1; then
  # New tab "hermes-run" in the current herdr workspace; its shell loads direnv
  # (GH_TOKEN etc.), so the token is never passed on a command line.
  out=$(herdr tab create --label hermes-run --cwd "$REPO_ROOT" ${HERDR_WORKSPACE_ID:+--workspace "$HERDR_WORKSPACE_ID"} 2>&1) || { echo "herdr tab create failed: $out" >&2; exit 1; }
  pane=$(printf '%s' "$out" | python3 -c 'import sys,json;print(json.load(sys.stdin)["result"]["root_pane"]["pane_id"])' 2>/dev/null)
  [ -n "$pane" ] || { echo "could not parse herdr pane id" >&2; exit 1; }
  herdr pane run "$pane" "$cmd" >/dev/null 2>&1 || { echo "herdr pane run failed" >&2; exit 1; }
  echo "started in herdr tab hermes-run (pane $pane)"; exit 0
fi
if command -v tmux >/dev/null 2>&1; then
  tmux has-session -t hermes-run 2>/dev/null && tmux kill-session -t hermes-run
  tmux new-session -d -s hermes-run "$cmd" && echo "started tmux session hermes-run (tmux attach -t hermes-run)"
else
  echo "neither herdr nor tmux usable" >&2; exit 1
fi
