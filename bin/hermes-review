#!/usr/bin/env bash
# hermes-review — reviewer agent for Hermes PRs in the CURRENT repo (or $HERMES_REPO).
#
# Usage: cd /path/to/target-repo && hermes-review [--dry-run] [--skip-agent] [--watch SECONDS] [--pr N]
#   --dry-run      print what it would do; comment, merge, close and create nothing
#   --skip-agent   no Claude call (only with --dry-run): identification + checks only
#   --watch N      keep polling every N seconds
#   --pr N         only this PR
#
# For each open, non-draft PR on a bd/<id> branch: verify the bead id (branch, title
# "type(<id>):", body "Bead: <id>") and that the bead is in_progress with the PR link;
# rebase the PR onto origin/main in a throwaway worktree; run the repo's checks there and
# on main (hermes-review.json, Python defaults) and keep only NEW problems; ask a
# headless `claude -p` reviewer (read-only tools) for a JSON verdict. Approved: review,
# `gh pr merge --rebase --match-head-commit`, `bd close --force`, `bd dolt push`.
# Otherwise: comment with each problem and file one tech-debt bead per problem.
#
# Env (optional): REVIEWER_GH_TOKEN  token of a SEPARATE GitHub identity; with it the
#                                    agent approves / requests changes, without it it
#                                    comments (GitHub refuses self-approval)
#                 REVIEWER_MODEL     claude model   HERMES_REVIEW_PYTHON  python >= 3.10
# Runs the PR's checks on the host, outside the Hermes sandbox.
set -uo pipefail
_s=${BASH_SOURCE[0]}
while [ -h "$_s" ]; do _d=$(cd "$(dirname "$_s")" && pwd); _s=$(readlink "$_s"); case $_s in /*) ;; *) _s="$_d/$_s" ;; esac; done
HARNESS_HOME=$(cd "$(dirname "$_s")/.." && pwd)
# shellcheck source=../lib/common.sh
. "$HARNESS_HOME/lib/common.sh"

case "${1:-}" in -h|--help) sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;; esac

hh_repo || exit 2
cd "$REPO_ROOT" || exit 2
for tool in gh bd git claude; do
  command -v "$tool" >/dev/null 2>&1 || { echo "missing required tool: $tool" >&2; exit 2; }
done

# A python >= 3.10 (the macOS system python3 is 3.9).
PY=${HERMES_REVIEW_PYTHON:-}
if [ -z "$PY" ]; then
  for c in python3.13 python3.12 python3.14 python3.11 python3.10 python3; do
    if command -v "$c" >/dev/null 2>&1 && "$c" -c 'import sys; sys.exit(sys.version_info < (3, 10))' 2>/dev/null; then
      PY=$(command -v "$c"); break
    fi
  done
fi
[ -n "$PY" ] || { echo "hermes-review needs python >= 3.10 (set HERMES_REVIEW_PYTHON)" >&2; exit 2; }

export HARNESS_HOME
PYTHONPATH="$HARNESS_HOME/lib${PYTHONPATH:+:$PYTHONPATH}" exec "$PY" -m pr_review "$@"
