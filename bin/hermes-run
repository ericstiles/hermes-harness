#!/usr/bin/env bash
# hermes-run — work up to N beads issues in the CURRENT repo via one-shot Hermes runs.
# Stops when the queue is empty, an issue is blocked, or a run fails/times out. Also stops,
# between runs and never mid-run, when a harness file it loaded changed since it started (a pull,
# branch switch or edit): it prints HARNESS_CHANGED with the files and the relaunch command,
# adds LOOP_STOP=HARNESS_CHANGED to the last run log, and ends FINAL_RESULT=HARNESS_CHANGED.
#
# Usage: hermes-run [--clean] [MAX_ISSUES]     (run from the target repo, or set HERMES_REPO)
#   MAX_ISSUES  stop after this many issues (default 10); each issue is one Hermes run, one PR
#   --clean  before the first run, reset the sandbox's clone (/workspace/<name>) to
#            origin/main; uncommitted work there is saved to logs/sandbox-dirty-*.patch
#   -h, --help  show this help and exit (needs no repo)
# Repo:   GITHUB_REPO=owner/name overrides; default is parsed from the origin remote.
# Model:  HERMES_ARGS="--provider ollama-launch -m qwen3.8:27b-mlx" overrides the config default.
# Needs:  GH_TOKEN exported (forwarded into the sandbox via docker_forward_env),
#         Docker/colima running, hermes + gh + bd on PATH.
#
# Env (all optional):
#   RUN_TIMEOUT=90m              per-run time limit (local 27B model needs > 45m); at the limit
#                                lib/watchdog.py extends a run that is making progress
#   HERMES_EXTEND=20m            extension per check when the interval since the last check
#                                shows progress (project file written/patched outside /tmp,
#                                git commit, PROGRESS: note); 0 = hard kill at RUN_TIMEOUT
#   HERMES_EXTEND_CAP=180m       no run (with its extensions) lives longer than this
#   HERMES_RETRY_ON_TIMEOUT=0|1  on a timeout, retry the same issue once with a
#                                larger timeout (2x, capped at HERMES_TIMEOUT_CAP=120m),
#                                resuming the killed session when it can be found
#   HERMES_WRAPUP_TIMEOUT=15m    after a TIMEOUT or a Hermes crash (AGENT_CRASHED), resume the
#                                session this long to push WIP to bd/<id> and append a
#                                "WIP:" note to the issue; 0 disables (lib/wrapup.sh)
#   HERMES_UNCLAIM_ON_TIMEOUT=1  after a timeout or crash (and its wrap-up), release the
#                                stuck claim so `bd ready` lists the issue again
#   HERMES_REPO=/path            act on this repo instead of the current directory
#   HERMES_LOG_DIR=/path         logs (default <repo>/logs; git-ignore it)
#   HERMES_TS_MIN_GAP=2          seconds of silence before a "(+Ns)" elapsed line
#   HERMES_BEADS_TIMEOUT=15s     time limit for each `bd` read behind the BEADS: lines and the
#                                requeue chain (lib/requeue.py)
#   HERMES_BASELINE_TIMEOUT=15s  time limit for `hermes prompt-size` behind the CONTEXT: baseline line
#   HERMES_CONTEXT_TIMEOUT=30s   time limit for the session export behind the CONTEXT: line
#   HERMES_CONTEXT_WINDOW=N      context window for the CONTEXT: line (default: looked up from Hermes
#                                config, its context_length_cache, then Ollama; never guessed)
#   HERMES_STALL_WARN=10m        print "no output for 10m (last: HH:MM:SS)" to the terminal and
#                                the timed log (never the raw log) after this much silence,
#                                again each further interval; 0 = off
#   HERMES_EXCLUDE_LABELS=owner-present  comma separated labels of issues a person must run:
#                                never picked, listed once per launch ("PICK: skipping ...");
#                                empty = skip nothing
#   HERMES_RESUME_ON_STOP=1      when the agent ends its turn mid-issue (no PR, no
#                                RUN_BLOCKED/RUN_REQUEUED/NO_READY_WORK: class AGENT_STOPPED),
#                                resume that same session ONCE; 0 disables
#
# The pick (bead 66y): hermes-run chooses the issue before every run and the prompt names it
# ("Work issue <id>"): the requeue chain's, else the first ready issue by priority without an
# excluded label. With nothing to name, the prompt gives the pick command that excludes them.
#
# Blocked by another bead (bead 35r): the agent adds the edge, releases its claim and prints
# RUN_REQUEUED (class REQUEUED). The loop checks that on the host (open, unassigned, an open
# `blocks` edge, no cycle, once per launch; else BLOCKED) and keeps going. Before every run, in
# this launch and later ones, it reads the requeued issues from beads: one whose blockers are
# closed is worked first, else its deepest ready blocker or a blocker's review fix, else the
# first ready issue. "REQUEUE CHAIN:" lines in the run log say why (lib/requeue.sh). A needs-a-human
# blocker stays RUN_BLOCKED and stops the loop.
#
# Every run's log ends with a line  RUN_RESULT=<CLASS>  (see lib/classify.sh)
# so hermes-supervise can parse the outcome instead of grepping prose.
# Logs per run: run-<stamp>.log is the RAW output (what the classifier reads);
# run-<stamp>.timed.txt is the same output with [HH:MM:SS] on every line and
# (+Ns) gaps, which is also what the terminal shows. The twin is deliberately
# not *.log, so hermes-status/hermes-supervise never mistake it for a run log.
set -uo pipefail

# Resolve symlinks (hermes-* are symlinked onto PATH), then locate the harness.
_s=${BASH_SOURCE[0]}
while [ -h "$_s" ]; do _d=$(cd "$(dirname "$_s")" && pwd); _s=$(readlink "$_s"); case $_s in /*) ;; *) _s="$_d/$_s" ;; esac; done
HARNESS_HOME=$(cd "$(dirname "$_s")/.." && pwd)
# shellcheck source=../lib/common.sh
. "$HARNESS_HOME/lib/common.sh"
hh_help_requested "$@" && { hh_print_help "${BASH_SOURCE[0]}"; exit 0; }
hh_repo || exit 2
cd "$REPO_ROOT" || exit 2
# shellcheck source=../lib/classify.sh
. "$HARNESS_HOME/lib/classify.sh"
# shellcheck source=../lib/runtime.sh
. "$HARNESS_HOME/lib/runtime.sh"
# shellcheck source=../lib/sandbox.sh
. "$HARNESS_HOME/lib/sandbox.sh"
# shellcheck source=../lib/notes_check.sh
. "$HARNESS_HOME/lib/notes_check.sh"
# shellcheck source=../lib/wrapup.sh
. "$HARNESS_HOME/lib/wrapup.sh"
# shellcheck source=../lib/stop_reason.sh
. "$HARNESS_HOME/lib/stop_reason.sh"
# shellcheck source=../lib/epics.sh
. "$HARNESS_HOME/lib/epics.sh"
# shellcheck source=../lib/requeue.sh
. "$HARNESS_HOME/lib/requeue.sh" # hh_requeue_accept / hh_chain_pick: the requeue chain (bead 35r)
# shellcheck source=../lib/code_stamp.sh
. "$HARNESS_HOME/lib/code_stamp.sh" # hh_code_stamp: stop between runs when the harness code changed

MAX=10; CLEAN=0
for _a in "$@"; do
  case "$_a" in
    --clean) CLEAN=1 ;;
    ''|*[!0-9]*) echo "hermes-run: unknown argument '$_a'. Usage: hermes-run [--clean] [MAX_ISSUES]" >&2; exit 2 ;;
    *) MAX=$_a ;;
  esac
done
# owner/name: $GITHUB_REPO, else parsed from the origin remote (see lib/common.sh)
hh_github_repo || { echo "GITHUB_REPO is not set and no origin remote was found in $REPO_ROOT. Fix: export GITHUB_REPO=owner/name, or git remote add origin <url>" >&2; exit 2; }
REPO=$GITHUB_REPO
NAME=${REPO##*/}
TIMEOUT=${RUN_TIMEOUT:-90m}
RETRY=${HERMES_RETRY_ON_TIMEOUT:-0}
UNCLAIM=${HERMES_UNCLAIM_ON_TIMEOUT:-1}
TIMEOUT_CAP_MIN=${HERMES_TIMEOUT_CAP:-120}; TIMEOUT_CAP_MIN=${TIMEOUT_CAP_MIN%m}
RESUME_ON_STOP=${HERMES_RESUME_ON_STOP:-1}
WRAPUP=${HERMES_WRAPUP_TIMEOUT:-15m}
EXTEND=${HERMES_EXTEND:-20m}
EXTEND_CAP=${HERMES_EXTEND_CAP:-180m}
# Marks these Hermes sessions as unattended harness runs. Hermes passes its environment to
# shell hooks, so lib/hooks/bd_notes_guard.py acts only here, not in interactive Hermes.
export HERMES_HARNESS_RUN=1
: "${GH_TOKEN:?export GH_TOKEN (fine-grained, this repo only)}"

# Labels of the issues left for a person (66y); an invalid setting refuses the run here, before
# anything is written. skip_args is what every `bd ready` that picks work gets.
skip_labels=$(hh_exclude_labels) || exit 2
skip_args=()
[ -z "$skip_labels" ] || skip_args=(--exclude-label "$skip_labels")

# The time limit is enforced by lib/watchdog.py (exit 124 like timeout(1)), not timeout(1).
WATCHDOG="$HARNESS_HOME/lib/watchdog.py"

# --- single-instance lock per repo (mkdir is atomic and portable; macOS has no flock) ---
mkdir -p "$LOG_DIR"
LOCK="$LOG_DIR/.run-beads.lock"
if ! mkdir "$LOCK" 2>/dev/null; then
  old=$(cat "$LOCK/pid" 2>/dev/null || true)
  if [ -n "$old" ] && kill -0 "$old" 2>/dev/null; then
    echo "hermes-run is already running (pid $old). Refusing to start a second instance." >&2
    exit 3
  fi
  echo "removing stale lock (pid ${old:-unknown} is gone)" >&2
  rm -rf "$LOCK"; mkdir "$LOCK" || exit 3
fi
echo $$ > "$LOCK/pid"
trap 'rm -rf "$LOCK"' EXIT
# Beads this loop iteration claimed (`bd update <id> --claim`), recorded by
# lib/hooks/bd_notes_guard.py, which blocks --append-notes on any other bead (incident
# 2026-11-24: the PR link went to organize_music-b8p.25 instead of organize_music-225).
# Emptied at the start of each iteration; resumed and wrap-up sessions share it.
export HERMES_HARNESS_CLAIMS="$LOCK/claims"
# The issues this launch requeued (once each); removed with the lock when the loop ends. The chain
# itself is read from beads (lib/requeue.sh), so it outlives the launch.
REQUEUE_HISTORY="$LOCK/requeued"; : > "$REQUEUE_HISTORY"

docker info >/dev/null 2>&1 || { echo "Docker daemon not running (try: colima start)" >&2; echo "RUN_RESULT=SANDBOX_DOWN"; exit 2; }

NO_HUMAN="No human is present and nobody will answer questions: never ask one or wait for \
confirmation; a reply without a tool call ends the session. Only stop when the PR URL is printed, \
or after printing RUN_BLOCKED, RUN_REQUEUED or NO_READY_WORK on its own line."
PROMPT_HEAD="Follow AGENTS.md \"Autonomous Beads workflow\" for the repo in /workspace/$NAME \
(clone $REPO with gh if missing; otherwise run: git fetch origin && git checkout --detach origin/main \
; never discard uncommitted changes: if git refuses, keep them and go on)."
# Step 1's command, said in the prompt: the target repo's AGENTS.md may be older, or the labels set.
PICK_RULE="pick with exactly this command and take the FIRST item: \`bd ready --json \
--exclude-type epic${skip_labels:+ --exclude-label $skip_labels} --sort priority\`"
PROMPT="$PROMPT_HEAD In step 1, $PICK_RULE. Do one issue, then stop. $NO_HUMAN"
named_prompt() { # <issue id> -> the prompt of a run whose issue hermes-run has picked
  printf '%s' "$PROMPT_HEAD Work issue $1 instead of the pick in step 1 (only if bd ready does \
not list it after bd dolt pull, $PICK_RULE). Do one issue, then stop. $NO_HUMAN"
}
# Sent when resuming a session that ended its turn mid-issue (class AGENT_STOPPED).
RESUME_PROMPT="$NO_HUMAN Continue the issue you already claimed, from where you stopped, \
following AGENTS.md \"Autonomous Beads workflow\" until its PR is open. Do not start another issue. \
If another bead blocks it, follow the requeue step and print RUN_REQUEUED; if only a human can \
unblock it, follow the blocker step and print RUN_BLOCKED."
# Sent when resuming a session that timed out or crashed, to save its work for the next run.
wrapup_prompt() { # <issue id or empty> <why the session is being wrapped up>
  local id=${1:-<the issue you claimed>}
  printf '%s' "No human is present; never ask a question. $2 This session gets only a few more \
minutes, so do NOT continue the implementation: save your progress for the next run, in as few \
terminal commands as possible. (1) In /workspace/$NAME, your branch is bd/$id, except on a \
review-fix issue, where it is the PR branch bd/<T> that the issue names. If it has uncommitted or \
unpushed changes, commit them as \"wip($id): <summary>\" and \
git push origin <branch>:refs/heads/<branch> (never main, never force-push). (2) bd update $id \
--append-notes \"WIP: <the branch if pushed, else none> - <what is done, what you found out, the \
next step>\", then bd dolt push. Do not close, unclaim or block \
the issue. Then print RUN_WIP_SAVED on its own line and stop."
}

# Effective model: HERMES_ARGS (-m/--model, --provider) wins over config.yaml.
read -ra _args <<< "${HERMES_ARGS:-}"
_cfg() { # _cfg <key>  -> value, or warn on stderr (never silent)
  local v; v=$(hermes config get "$1" 2>/dev/null | tail -n1)
  [ -n "$v" ] || echo "warning: 'hermes config get $1' returned nothing" >&2
  printf '%s' "$v"
}
MODEL=$(_cfg model.default)
PROVIDER=$(_cfg model.provider)
for ((j = 0; j < ${#_args[@]}; j++)); do
  case "${_args[j]}" in
    -m|--model) MODEL=${_args[j+1]:-$MODEL} ;;
    --model=*) MODEL=${_args[j]#--model=} ;;
    --provider) PROVIDER=${_args[j+1]:-$PROVIDER} ;;
    --provider=*) PROVIDER=${_args[j]#--provider=} ;;
  esac
done
IMAGE=$(_cfg terminal.docker_image)
echo "== repo: $REPO | model: ${MODEL:-unknown} | provider: ${PROVIDER:-unknown} | sandbox: ${IMAGE:-default} | timeout: $TIMEOUT (+$EXTEND on progress, cap $EXTEND_CAP) | retry-on-timeout: $RETRY | max issues: $MAX"
if [ "$CLEAN" = 1 ]; then
  [ -n "$IMAGE" ] || { echo "clean: terminal.docker_image is not set, so the sandbox container cannot be found; not starting a run" >&2; exit 2; }
  hh_sandbox_reset "$IMAGE" "$NAME" "$LOG_DIR" || exit 2
fi

# The run's bead is the FIRST id it claimed (lib/runtime.sh hh_claimed_issue), here and in the timed
# log's stamps (lib/tsfilter.py): a review-fix run's later `bd update B --claim` only marks a side
# bead. A first claim that failed (bead held elsewhere) would be named instead; with one run at a
# time that is rare, and every use below would be off the same way.
claimed_issue() { hh_claimed_issue "$1"; } # <logfile> -> the run's bead, empty if none
existing_pr() { # <issue> -> URL of a PR from branch bd/<issue>, empty if none or gh fails
  [ -n "$1" ] || return 0
  gh pr list --repo "$REPO" --head "bd/$1" --state all --json url -q '.[0].url' 2>/dev/null | head -n 1
}
session_id() { # <logfile> -> Hermes session id from the exit footer ("Session:  <id>"), empty if none
  tr -d '\r' < "$1" | sed -n 's/^Session: *\([0-9A-Za-z_]*\)$/\1/p' | tail -n 1
}

# Release a claim left behind by a killed run so the next run can pick it up.
unclaim_stale() { # <logfile>
  [ "$UNCLAIM" = 1 ] || return 0
  local id
  id=$(claimed_issue "$1")
  [ -n "$id" ] || { echo "note: could not find a claimed issue id in $1"; return 0; }
  bd dolt pull >/dev/null 2>&1 || echo "warning: bd dolt pull failed; claim state may be stale"
  if bd list --status=in_progress 2>/dev/null | grep -q "$id"; then
    if bd unclaim "$id" >/dev/null 2>&1; then
      echo "released stale claim on $id"; bd dolt push >/dev/null 2>&1 || echo "warning: bd dolt push failed (unclaim is local only)"
    else echo "warning: bd unclaim $id failed"; fi
  else
    echo "note: $id is not in_progress in beads; nothing to release"
  fi
}

# One Hermes run. Sets: log, timed, status, class, run_start (YYYYMMDD_HHMMSS, to find the session),
# STAMP_ID (the bead its timed log is stamped with, empty if unknown).
run_once() { # <timeout> [session-id-to-resume [prompt]]   (a custom prompt = wrap-up: no extension)
  local stamp start end issue prompt=${iter_prompt:-$PROMPT} extend=$EXTEND cap=$EXTEND_CAP
  local -a ps resume=()
  # A resumed session does not claim again: its bead is in the log before it (the run being
  # resumed, else this iteration's claim log). A fresh run starts with no id.
  STAMP_ID=""
  if [ -n "${2:-}" ]; then
    resume=(--resume "$2"); prompt=${3:-$RESUME_PROMPT}
    [ ! -f "${log:-}" ] || STAMP_ID=$(claimed_issue "$log")
    [ -n "$STAMP_ID" ] || [ ! -f "${claim_log:-}" ] || STAMP_ID=$(claimed_issue "$claim_log")
  fi
  if [ -n "${3:-}" ]; then extend=0; cap=$1; fi
  run_start=$(date +%Y%m%d_%H%M%S)
  stamp=$(date +%Y%m%d-%H%M%S)
  # two runs in the same second (a fast resume/retry) must not overwrite each other's log
  local n=1 base=$stamp
  while [ -e "$LOG_DIR/run-$stamp.log" ]; do n=$((n + 1)); stamp="$base-$n"; done
  log="$LOG_DIR/run-$stamp.log"; timed="$LOG_DIR/run-$stamp.timed.txt"
  echo "== run $i/$MAX | model: ${MODEL:-unknown} | timeout: $1 -> $log (timestamped: ${timed##*/})"
  start=$(date +%s)
  # Raw output goes to $log BEFORE the timestamp filter. SIGPIPE is ignored for
  # this pipeline so that if the filter ever dies, tee keeps writing the raw log
  # (and Hermes keeps running) instead of being killed by a broken pipe. BSD tee
  # then reports "Broken pipe" on every write, so its stderr goes to a file, not
  # the terminal. Degraded mode: no live terminal output until the run ends.
  local tee_err="$LOG_DIR/.tee-stderr"
  trap '' PIPE
  # shellcheck disable=SC2086  # HERMES_ARGS is intentionally word-split
  # --pass-session-id: Hermes sees its session id and writes `Hermes-Session:` in the PR.
  # The fixed prompt baseline goes first, ahead of Hermes' output, through the same pipe (39w.3);
  # the group's exit status is the watchdog's, so PIPESTATUS[0] still is Hermes' status.
  # A resumed or wrap-up run (a session id was given) skips it: it describes a FRESH session's
  # prompt, and its time limit would eat into a short wrap-up (0af).
  # The BEADS: line (9jj) follows it: the bead the agent is expected to pick, and the queue.
  # Every run, resumed ones too, then records its effective provider (RUN_PROVIDER:): hermes-supervise
  # checks that provider's endpoint after a MODEL_API_ERROR (b80); HERMES_ARGS may override config.
  # The REQUEUE CHAIN: (35r) and PICK: (66y) lines say why this run's issue was chosen or skipped.
  local baseline="" beads="" why=""
  [ -n "${2:-}" ] || { baseline=$(baseline_line); beads=$(beads_start_line); why=${pick_log:-}; }
  { [ -z "$baseline" ] || printf '%s\n' "$baseline"
    [ -z "$why" ] || printf '%s\n' "$why"
    [ -z "$beads" ] || printf '%s\n' "$beads"
    printf 'RUN_PROVIDER: %s\n' "${PROVIDER:-unknown}"
    python3 -u "$WATCHDOG" --limit "$1" --extend "$extend" --cap "$cap" --log "$log" -- \
      hermes chat --pass-session-id ${resume[@]+"${resume[@]}"} ${HERMES_ARGS:-} -q "$prompt" 2>&1; } \
    | tee "$log" 2>"$tee_err" | python3 -u "$HARNESS_HOME/lib/tsfilter.py" --log "$timed" --id "$STAMP_ID"
  ps=("${PIPESTATUS[@]}")
  trap - PIPE
  status=${ps[0]}; end=$(date +%s)
  if [ "${ps[2]}" != 0 ]; then
    echo "warning: timestamp filter failed (exit ${ps[2]}); live output stopped, the raw log still has everything: $log" >&2
  elif [ "${ps[1]}" != 0 ]; then
    echo "warning: tee failed writing the raw log (exit ${ps[1]}): $(head -n 1 "$tee_err" 2>/dev/null)" >&2
  fi
  rm -f "$tee_err"
  # Why Hermes stopped (agent.log "Turn ended"), before RUN_RESULT so the classifier can use it.
  [ -n "$STAMP_ID" ] || STAMP_ID=$(claimed_issue "$log") # as tsfilter.py ended: --id, else 1st claim
  local sid stop_line ctx_line; sid=$(run_session)
  stop_line="STOP_REASON: $(hh_stop_reason "$sid")"
  echo "$stop_line" | tee -a "$log"
  hh_stamp_line "$stop_line" "$STAMP_ID" >> "$timed" 2>/dev/null || true
  class=$(hermes_classify "$log" "$status")
  # Token usage AFTER classification (it cannot affect the class) and before RUN_RESULT (last).
  ctx_line=$(context_line "$sid")
  echo "$ctx_line" | tee -a "$log"
  hh_stamp_line "$ctx_line" "$STAMP_ID" >> "$timed" 2>/dev/null || true
  echo "RUN_RESULT=$class" | tee -a "$log"
  issue=$(claimed_issue "$log")
  RUN_TIME_LINE="RUN_TIME start=$(hh_hms "$start") end=$(hh_hms "$end") elapsed=$(hh_elapsed $((end - start))) issue=${issue:-unknown}"
  echo "$RUN_TIME_LINE"
  { hh_stamp_line "RUN_RESULT=$class" "$STAMP_ID"; hh_stamp_line "$RUN_TIME_LINE" "$STAMP_ID"; } >> "$timed" 2>/dev/null || true
  runs=$((runs + 1))
}

# An OK_DONE run whose bead lost its PR link (in_progress + URL in notes) is NOTES_LOST:
# hermes-review would refuse the PR and the queue would stall unnoticed. hh_notes_check appends a
# missing `PR:` line itself and flags other beads that picked the URL up since $iter_start.
notes_check() {
  local claimed out rc
  claimed=$(claimed_issue "$log")
  [ -n "$claimed" ] || [ -z "$stopped_log" ] || claimed=$(claimed_issue "$stopped_log")
  out=$(hh_notes_check "$log" "$claimed" "$iter_start"); rc=$?
  [ -n "$out" ] && printf '%s\n' "$out"
  [ "$rc" = 1 ] || return 0
  class=NOTES_LOST
  { printf '%s\n' "$out"; echo "RUN_RESULT=NOTES_LOST"; } >> "$log"
  hh_stamp_line "RUN_RESULT=NOTES_LOST" "$STAMP_ID" >> "$timed" 2>/dev/null || true
}

# The session of the run that just ended: its footer, else (killed or crashed, no footer) the
# harness session that started with it in Hermes' store.
run_session() { local s; s=$(session_id "$log"); [ -n "$s" ] || s=$(hh_find_session "$run_start"); printf '%s' "$s"; }

# bd under the watchdog (a stuck bd must not hold up the loop); prints its stdout, returns its exit.
_beads_bd() {
  python3 "$WATCHDOG" --limit "${HERMES_BEADS_TIMEOUT:-15s}" --extend 0 --grace 2s --log /dev/null -- \
    bd "$@" 2>/dev/null
}

# One "BEADS: ..." line (lib/bead_stats.py, bead 9jj): `start` = the bead the agent is expected to
# claim (its own pick command, AGENTS.md step 1) and the queue's counts; `summary <ids>` = what the
# loop worked and what is left. Always exactly one BEADS: line and exit 0.
_beads_line() { # start | summary [id ...]
  local mode=$1 stats ready rc line; shift
  stats=$(_beads_bd stats --json); rc=$?
  if [ "$rc" = 124 ]; then echo "BEADS: unavailable (bd stats timed out after ${HERMES_BEADS_TIMEOUT:-15s})"; return 0; fi
  if [ "$mode" = start ]; then
    # A failed or timed-out `bd ready` passes "" (next unavailable); "[]" would read as an empty queue.
    # On the requeue chain the harness has already chosen: show that bead instead.
    if [ -n "${chain_pick:-}" ]; then ready=$(_beads_bd show "$chain_pick" --json) || ready=""
    elif ready=$(_beads_bd ready --json --exclude-type epic ${skip_args[@]+"${skip_args[@]}"} \
      --sort priority --limit 1); then ready=${ready:-[]}
    else ready=""; fi
    line=$(python3 "$HARNESS_HOME/lib/bead_stats.py" start "$stats" "$ready" 2>/dev/null | head -n 1)
  else
    line=$(python3 "$HARNESS_HOME/lib/bead_stats.py" summary "$stats" "$@" 2>/dev/null | head -n 1)
  fi
  case $line in "BEADS: "*) printf '%s\n' "$line" ;; *) echo "BEADS: unavailable (bead_stats.py printed no line)" ;; esac
  return 0
}
beads_start_line() { _beads_line start; }

# One "CONTEXT: baseline ..." line: the fixed prompt budget of a fresh session from
# `hermes prompt-size --json` (offline, run in the repo root so the context files are the
# target repo's). Hermes reports chars/bytes there, not tokens. Never fails the run.
baseline_line() {
  local json rc limit=${HERMES_BASELINE_TIMEOUT:-15s}
  json=$(python3 "$WATCHDOG" --limit "$limit" --extend 0 --grace 2s --log /dev/null -- \
         hermes prompt-size --json 2>/dev/null); rc=$?
  if [ "$rc" = 124 ]; then
    echo "CONTEXT: baseline unavailable (hermes prompt-size timed out after $limit)"
    return 0
  fi
  if [ "$rc" != 0 ]; then
    echo "CONTEXT: baseline unavailable (hermes prompt-size exited $rc)"
    return 0
  fi
  json=$(printf '%s\n' "$json" | python3 "$HARNESS_HOME/lib/context_usage.py" --baseline 2>/dev/null | head -n 1)
  case $json in
    "CONTEXT: baseline "*) printf '%s\n' "$json" ;;
    *) echo "CONTEXT: baseline unavailable (context_usage.py printed no baseline line)" ;;
  esac
  return 0
}

# One "CONTEXT: ..." line with the session's token usage (lib/context_usage.py): cumulative
# counts, no %, since Hermes keeps no per-call prompt size. The export is piped, never written
# to disk. Always exactly one CONTEXT: line and exit 0: it must never change a run's result.
context_line() { # <session-id>
  local out export_json rc limit=${HERMES_CONTEXT_TIMEOUT:-30s}
  if [ -z "$1" ]; then
    echo "CONTEXT: unavailable (no session found: no Session: footer and no harness session in hermes sessions list)"
    return 0
  fi
  # A stuck Hermes CLI must not hold up the loop: the watchdog (no extensions) stops the export
  # at $limit and exits 124. Its own WATCHDOG: note goes to this variable, never to the logs.
  export_json=$(python3 "$WATCHDOG" --limit "$limit" --extend 0 --grace 2s --log /dev/null -- \
                hermes sessions export --session-id "$1" - 2>/dev/null); rc=$?
  if [ "$rc" = 124 ]; then
    echo "CONTEXT: unavailable (export timed out after $limit)"
    return 0
  fi
  # shellcheck disable=SC2086  # the optional --window pair is intentionally word-split
  out=$(printf '%s\n' "$export_json" \
        | python3 "$HARNESS_HOME/lib/context_usage.py" ${HERMES_CONTEXT_WINDOW:+--window $HERMES_CONTEXT_WINDOW} 2>/dev/null \
        | head -n 1)
  case $out in
    "CONTEXT: "*) printf '%s\n' "$out" ;;
    *) echo "CONTEXT: unavailable (context_usage.py printed no CONTEXT line)" ;;
  esac
  return 0
}

# A TIMEOUT, AGENT_CRASHED or TURN_LIMIT run leaves no PR. Resume its session for a short wrap-up that pushes
# WIP and appends a "WIP:" note (lib/wrapup.sh), so the next run starts from it, not from zero.
# The wrap-up gets its own log ending WRAPUP_OF=<failed log> and the failed run's RUN_RESULT;
# class is left as the failed run's class.
wrap_up() { # <log with the claim> [session id, when already known]
  local failed=$class failed_log=$log sid=${2:-} why
  case "$WRAPUP" in 0|0m|0s|'') return 0 ;; esac
  [ -n "$sid" ] || sid=$(run_session)
  [ -n "$sid" ] || { echo "note: no Hermes session found for $failed_log; cannot save its progress"; return 0; }
  case "$failed" in
    TIMEOUT) why="The run's time limit was reached." ;;
    TURN_LIMIT) why="The session used its whole tool-call budget." ;;
    *) why="Hermes crashed with an error (a crash) and this session was resumed after it." ;;
  esac
  echo "Run ended as $failed; resuming session $sid for a $WRAPUP wrap-up to save its progress."
  run_once "$WRAPUP" "$sid" "$(wrapup_prompt "$(claimed_issue "$1")" "$why")"
  if hh_wip_saved "$log"; then echo "Progress saved (RUN_WIP_SAVED); see the issue's WIP: note."
  else echo "warning: the wrap-up did not confirm RUN_WIP_SAVED (it ended as $class); progress may be lost. See $log"; fi
  { echo "WRAPUP_OF=$failed_log"; echo "RUN_RESULT=$failed"; } >> "$log"
  hh_stamp_line "RUN_RESULT=$failed" "$STAMP_ID" >> "$timed" 2>/dev/null || true
  class=$failed
}

# Save what a failed run did, then release its claim.
save_and_release() { # <log with the claim> [session id]
  case "$class" in TIMEOUT|AGENT_CRASHED|TURN_LIMIT) ;; *) return 0 ;; esac
  wrap_up "$@"
  unclaim_stale "$1"
}

# A line about the requeue chain: to the terminal, the last run log and its timed twin.
requeue_say() { # <line>
  echo "$1" | tee -a "$log"
  hh_stamp_line "$1" "$STAMP_ID" >> "$timed" 2>/dev/null || true
}
# A REQUEUED run (bead 35r): trust it only if the host's beads agree. Accepted: the loop goes on
# (later picks read the chain from beads). Refused: the run becomes BLOCKED, and the loop stops.
requeue_check() {
  local id out blockers
  id=$(claimed_issue "${claim_log:-$log}")
  bd dolt pull >/dev/null 2>&1 || requeue_say "warning: bd dolt pull failed; checking the requeue against local beads"
  if ! out=$(hh_requeue_accept "$REQUEUE_HISTORY" "$id"); then
    class=BLOCKED
    requeue_say "REQUEUE_REFUSED: $out"
    requeue_say "REQUEUE CHAIN: the run counts as BLOCKED; beads are left as the agent left them (bd show ${id:-<id>})"
    requeue_say "RUN_RESULT=BLOCKED"
    return 0
  fi
  blockers=${out%% *}
  requeued_pairs="${requeued_pairs:+$requeued_pairs }$id->$blockers"
  requeue_say "REQUEUE: $id blocked by $blockers"
  case $out in
    *" UNNOTED") # the note is what later launches find the issue by
      if bd update "$id" --append-notes "REQUEUED: blocked by $blockers (note added by hermes-run)" >/dev/null 2>&1; then
        requeue_say "REQUEUE CHAIN: $id had no REQUEUED note; added it so later launches remember it"
        bd dolt push >/dev/null 2>&1 || requeue_say "warning: bd dolt push failed (the note is local only)"
      else
        requeue_say "warning: could not add the REQUEUED note to $id; later picks will not give it priority"
      fi ;;
  esac
  requeue_say "REQUEUE CHAIN: $id is open again; it is taken first once $blockers is closed (its PR merged)"
}
# Lines saying why this run's issue was chosen or skipped; run_once writes them into its log.
add_pick_log() { # <lines, may be empty>
  [ -n "$1" ] || return 0
  [ -z "$pick_log" ] || pick_log="$pick_log
"
  pick_log="$pick_log$1"
}
# At the loop's end: what is still waiting and what the next launch will start with.
requeue_state() {
  local line
  hh_chain_pick
  [ -n "$HH_CHAIN_LOG" ] && [ -n "${log:-}" ] || return 0
  requeue_say "REQUEUE CHAIN: state at the end of this loop (the next launch starts from it):"
  while IFS= read -r line; do requeue_say "$line"; done <<EOF
$HH_CHAIN_LOG
EOF
}

# The loop's end: summary lines, then exit by the final result. A function, so a loop that stops
# because its code changed (harness_changed) never reads the rest of this file from disk again.
loop_epilogue() {
  loop_end=$(date +%s)
  requeue_state
  _beads_line summary ${WORKED:-} ${requeued_pairs:+--requeued $requeued_pairs}
  echo "RUN_TIME total=$(hh_elapsed $((loop_end - loop_start))) start=$(hh_hms "$loop_start") end=$(hh_hms "$loop_end") runs=$runs"
  echo "FINAL_RESULT=$final"
  case "$final" in OK_DONE|QUEUE_EMPTY|REQUEUED) exit 0 ;; *) exit 1 ;; esac
}

# Bead eyx: the harness files this loop runs, as they were when it started. A pull, branch switch
# or edit of any of them while the loop runs stops it before its next run (never mid-run): bash
# would otherwise run a mix of old (in memory) and new (re-read from disk) code.
CODE_STAMP=$(hh_code_stamp "$HARNESS_HOME")
harness_changed() { # <changed paths> <next run number>: say why, mark the last run log, stop
  echo "HARNESS_CHANGED: the harness code changed since this loop started ($1)." \
    "Stopping before run $2 so the next loop runs the new code; the finished runs are not affected." \
    "Relaunch from $REPO_ROOT: hermes-launch --reason HARNESS_CHANGED --max $((MAX - $2 + 1))"
  [ -n "${log:-}" ] && echo "LOOP_STOP=HARNESS_CHANGED left=$((MAX - $2 + 1)) files=$1" >> "$log"
  final=HARNESS_CHANGED
  loop_epilogue
}

final=OK_DONE; WORKED=""  # beads claimed by this loop's main runs (BEADS: summary)
requeued_pairs=""; chain_pick=""; pick_log=""; iter_prompt="" # "<id>-><blockers>" accepted; this run's pick
waiting_line="" # the issues skipped for a person: said once per launch
loop_start=$(date +%s); runs=0
for i in $(seq 1 "$MAX"); do
  if [ "$i" -gt 1 ] && changed=$(hh_code_changes "$HARNESS_HOME" "$CODE_STAMP"); then
    harness_changed "$changed" "$i"
  fi
  stopped_log=""; sid=""; iter_start=$(date +%s); : > "$HERMES_HARNESS_CLAIMS"
  # Which issue this run works, and why: the requeue chain (35r), else the first ready one (66y).
  bd dolt pull >/dev/null 2>&1 || echo "warning: bd dolt pull failed; picking from local beads"
  hh_chain_pick; chain_pick=$HH_CHAIN_PICK; pick=$chain_pick; pick_log=$HH_CHAIN_LOG; iter_prompt=""
  if [ -z "$pick" ]; then hh_normal_pick; pick=$HH_PICK; add_pick_log "$HH_PICK_LOG"; fi
  if [ -z "$waiting_line" ]; then waiting_line=$(hh_waiting_line); add_pick_log "$waiting_line"; fi
  [ -z "$pick" ] || iter_prompt=$(named_prompt "$pick")
  run_once "$TIMEOUT"; claim_log=$log
  worked=$(claimed_issue "$claim_log"); echo "BEADS: worked ${worked:-none}"
  [ -n "$worked" ] && WORKED="${WORKED:+$WORKED }$worked"
  if [ "$class" = TIMEOUT ] && [ "$RETRY" = 1 ]; then
    cur=${TIMEOUT%m}; case "$cur" in ''|*[!0-9]*) cur=90 ;; esac
    bigger=$(( cur * 2 )); [ "$bigger" -gt "$TIMEOUT_CAP_MIN" ] && bigger=$TIMEOUT_CAP_MIN
    sid=$(run_session)
    if [ -n "$sid" ]; then
      # same session: it keeps everything it explored, and its claim
      echo "Timed out; retrying the issue once with ${bigger}m by resuming session $sid."
      run_once "${bigger}m" "$sid"
    else
      unclaim_stale "$log"
      echo "Timed out; retrying the issue once with ${bigger}m (no session found to resume)."
      run_once "${bigger}m"; claim_log=$log
    fi
  fi
  save_and_release "$claim_log" "$sid"
  # The agent ended its turn mid-issue (e.g. asked a question nobody will answer):
  # resume that same session once. Never twice: a second early stop ends the loop.
  # First ask GitHub: the agent may have opened the PR but never printed its URL.
  if [ "$class" = AGENT_STOPPED ]; then
    pr=$(existing_pr "$(claimed_issue "$log")")
    if [ -n "$pr" ]; then
      echo "A PR for the claimed issue already exists ($pr); counting the run as OK_DONE."
      class=OK_DONE; printf 'PR found by hermes-run: %s\nRUN_RESULT=OK_DONE\n' "$pr" >> "$log"
    fi
  fi
  if [ "$class" = AGENT_STOPPED ] && [ "$RESUME_ON_STOP" = 1 ]; then
    stopped_log=$log; sid=$(session_id "$log")
    if [ -n "$sid" ]; then
      echo "Agent ended its turn without a PR or a stop marker; resuming session $sid once."
      run_once "$TIMEOUT" "$sid"
      # the claim is in the first log, not the resumed one
      save_and_release "$stopped_log" "$sid"
    else
      echo "note: no session id in $log; cannot resume"
    fi
  fi
  [ "$class" = OK_DONE ] && notes_check
  [ "$class" = REQUEUED ] && requeue_check
  final=$class
  done_id=$(claimed_issue "$claim_log")
  echo "== run $i/$MAX completed: $class (issue ${done_id:-none})" # the final result (bead iqf)
  case "$class" in
    OK_DONE|REQUEUED) continue ;;
    NOTES_LOST) echo "The PR's bead lost its PR link (NOTES_CHECK lines above); hermes-review would refuse the PR — stopping. See $log"; break ;;
    QUEUE_EMPTY)
      # A finished epic left open can block all remaining work (xw2.2): close eligible epics
      # first, and if any closed, run again instead of stopping.
      epics=$(hh_close_eligible_epics)
      if [ -n "$epics" ]; then
        printf '%s\n' "$epics"
        echo "Closed finished epics that were blocking the queue; checking for ready work again."
        continue
      fi
      echo "Queue empty."; final=QUEUE_EMPTY; break ;;
    BLOCKED) echo "Issue blocked — stopping. See $log"; break ;;
    MODEL_API_ERROR) echo "Agent made no progress (model/API error) — stopping. See $log"; break ;;
    MODEL_OOM) echo "The model server ran out of memory — stopping; a relaunch would hit the same wall. Fix one, then relaunch: free memory (quit other apps), restart the model server, lower the context (model.context_length / the server's --context-window), or use a q8 KV cache. See $log"; break ;;
    TIMEOUT) echo "Run timed out — stopping. See $log"; break ;;
    TURN_LIMIT) echo "The session used its whole tool-call budget ($(sed -n 's/^STOP_REASON: //p' "$claim_log" | tail -n 1)) — the issue is probably too big: split it. Stopping. See $claim_log"; break ;;
    AGENT_CRASHED) echo "Hermes crashed (traceback in the log) — stopping. See $claim_log"; break ;;
    AGENT_STOPPED) echo "Agent stopped mid-issue without a PR — stopping. Read the end of $log, then resume by hand: hermes --resume $(session_id "$log")"; break ;;
    *) echo "Run ended as $class — stopping. See $log"; break ;;
  esac
# On the same line as `done`, so bash parses it with the loop and never re-reads this file for it.
done; loop_epilogue
