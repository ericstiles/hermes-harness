#!/usr/bin/env bash
# hermes-run — work up to N beads issues in the CURRENT repo via one-shot Hermes runs.
# Stops when the queue is empty, an issue is blocked, or a run fails/times out.
#
# Usage:  cd /path/to/target-repo && hermes-run [--clean] [MAX_ISSUES]
#   --clean  before the first run, reset the sandbox's clone (/workspace/<name>) to
#            origin/main; uncommitted work there is saved to logs/sandbox-dirty-*.patch
# Repo:   GITHUB_REPO=owner/name overrides; default is parsed from the origin remote.
# Model:  HERMES_ARGS="--provider ollama-launch -m qwen3.8:27b-mlx" overrides the config default.
# Needs:  GH_TOKEN exported (forwarded into the sandbox via docker_forward_env),
#         Docker/colima running, hermes + gh + bd on PATH.
#
# Env (all optional):
#   RUN_TIMEOUT=90m              per-run time limit (local 27B model needs > 45m); at the limit
#                                lib/watchdog.py extends a run that is making progress
#   HERMES_EXTEND=20m            extension per check when the interval since the last check
#                                shows progress (project file written/patched outside /tmp,
#                                git commit, PROGRESS: note); 0 = hard kill at RUN_TIMEOUT
#   HERMES_EXTEND_CAP=180m       no run (with its extensions) lives longer than this
#   HERMES_RETRY_ON_TIMEOUT=0|1  on a timeout, retry the same issue once with a
#                                larger timeout (2x, capped at HERMES_TIMEOUT_CAP=120m),
#                                resuming the killed session when it can be found
#   HERMES_WRAPUP_TIMEOUT=15m    after a TIMEOUT or a Hermes crash (AGENT_CRASHED), resume the
#                                session this long to push WIP to bd/<id> and append a
#                                "WIP:" note to the issue; 0 disables (lib/wrapup.sh)
#   HERMES_UNCLAIM_ON_TIMEOUT=1  after a timeout or crash (and its wrap-up), release the
#                                stuck claim so `bd ready` lists the issue again
#   HERMES_REPO=/path            act on this repo instead of the current directory
#   HERMES_LOG_DIR=/path         logs (default <repo>/logs; git-ignore it)
#   HERMES_TS_MIN_GAP=2          seconds of silence before a "(+Ns)" elapsed line
#   HERMES_RESUME_ON_STOP=1      when the agent ends its turn mid-issue (no PR, no
#                                RUN_BLOCKED/NO_READY_WORK: class AGENT_STOPPED),
#                                resume that same session ONCE; 0 disables
#
# Every run's log ends with a line  RUN_RESULT=<CLASS>  (see lib/classify.sh)
# so hermes-supervise can parse the outcome instead of grepping prose.
# Logs per run: run-<stamp>.log is the RAW output (what the classifier reads);
# run-<stamp>.timed.txt is the same output with [HH:MM:SS] on every line and
# (+Ns) gaps, which is also what the terminal shows. The twin is deliberately
# not *.log, so hermes-status/hermes-supervise never mistake it for a run log.
set -uo pipefail

# Resolve symlinks (hermes-* are symlinked onto PATH), then locate the harness.
_s=${BASH_SOURCE[0]}
while [ -h "$_s" ]; do _d=$(cd "$(dirname "$_s")" && pwd); _s=$(readlink "$_s"); case $_s in /*) ;; *) _s="$_d/$_s" ;; esac; done
HARNESS_HOME=$(cd "$(dirname "$_s")/.." && pwd)
# shellcheck source=../lib/common.sh
. "$HARNESS_HOME/lib/common.sh"
hh_repo || exit 2
cd "$REPO_ROOT" || exit 2
# shellcheck source=../lib/classify.sh
. "$HARNESS_HOME/lib/classify.sh"
# shellcheck source=../lib/runtime.sh
. "$HARNESS_HOME/lib/runtime.sh"
# shellcheck source=../lib/sandbox.sh
. "$HARNESS_HOME/lib/sandbox.sh"
# shellcheck source=../lib/notes_check.sh
. "$HARNESS_HOME/lib/notes_check.sh"
# shellcheck source=../lib/wrapup.sh
. "$HARNESS_HOME/lib/wrapup.sh"

MAX=10; CLEAN=0
for _a in "$@"; do
  case "$_a" in
    --clean) CLEAN=1 ;;
    ''|*[!0-9]*) echo "hermes-run: unknown argument '$_a'. Usage: hermes-run [--clean] [MAX_ISSUES]" >&2; exit 2 ;;
    *) MAX=$_a ;;
  esac
done
# owner/name: $GITHUB_REPO, else parsed from the origin remote (see lib/common.sh)
hh_github_repo || { echo "GITHUB_REPO is not set and no origin remote was found in $REPO_ROOT. Fix: export GITHUB_REPO=owner/name, or git remote add origin <url>" >&2; exit 2; }
REPO=$GITHUB_REPO
NAME=${REPO##*/}
TIMEOUT=${RUN_TIMEOUT:-90m}
RETRY=${HERMES_RETRY_ON_TIMEOUT:-0}
UNCLAIM=${HERMES_UNCLAIM_ON_TIMEOUT:-1}
TIMEOUT_CAP_MIN=${HERMES_TIMEOUT_CAP:-120}; TIMEOUT_CAP_MIN=${TIMEOUT_CAP_MIN%m}
RESUME_ON_STOP=${HERMES_RESUME_ON_STOP:-1}
WRAPUP=${HERMES_WRAPUP_TIMEOUT:-15m}
EXTEND=${HERMES_EXTEND:-20m}
EXTEND_CAP=${HERMES_EXTEND_CAP:-180m}
# Marks these Hermes sessions as unattended harness runs. Hermes passes its environment to
# shell hooks, so lib/hooks/bd_notes_guard.py acts only here, not in interactive Hermes.
export HERMES_HARNESS_RUN=1
: "${GH_TOKEN:?export GH_TOKEN (fine-grained, this repo only)}"

# The time limit is enforced by lib/watchdog.py (exit 124 like timeout(1)), not timeout(1).
WATCHDOG="$HARNESS_HOME/lib/watchdog.py"

# --- single-instance lock per repo (mkdir is atomic and portable; macOS has no flock) ---
mkdir -p "$LOG_DIR"
LOCK="$LOG_DIR/.run-beads.lock"
if ! mkdir "$LOCK" 2>/dev/null; then
  old=$(cat "$LOCK/pid" 2>/dev/null || true)
  if [ -n "$old" ] && kill -0 "$old" 2>/dev/null; then
    echo "hermes-run is already running (pid $old). Refusing to start a second instance." >&2
    exit 3
  fi
  echo "removing stale lock (pid ${old:-unknown} is gone)" >&2
  rm -rf "$LOCK"; mkdir "$LOCK" || exit 3
fi
echo $$ > "$LOCK/pid"
trap 'rm -rf "$LOCK"' EXIT

docker info >/dev/null 2>&1 || { echo "Docker daemon not running (try: colima start)" >&2; echo "RUN_RESULT=SANDBOX_DOWN"; exit 2; }

NO_HUMAN="No human is present and nobody will answer questions: never ask one or wait for \
confirmation; a reply without a tool call ends the session. Only stop when the PR URL is printed, \
or after printing RUN_BLOCKED or NO_READY_WORK on its own line."
PROMPT="Follow AGENTS.md \"Autonomous Beads workflow\" for the repo in /workspace/$NAME \
(clone $REPO with gh if missing, otherwise git pull). Do one issue, then stop. $NO_HUMAN"
# Sent when resuming a session that ended its turn mid-issue (class AGENT_STOPPED).
RESUME_PROMPT="$NO_HUMAN Continue the issue you already claimed, from where you stopped, \
following AGENTS.md \"Autonomous Beads workflow\" until its PR is open. Do not start another issue. \
If you cannot finish it, follow the blocker step and print RUN_BLOCKED."
# Sent when resuming a session that timed out or crashed, to save its work for the next run.
wrapup_prompt() { # <issue id or empty> <why the session is being wrapped up>
  local id=${1:-<the issue you claimed>}
  printf '%s' "No human is present; never ask a question. $2 This session gets only a few more \
minutes, so do NOT continue the implementation: save your progress for the next run, in as few \
terminal commands as possible. (1) In /workspace/$NAME, if branch bd/$id has uncommitted or \
unpushed changes, commit them as \"wip($id): <summary>\" and git push origin bd/$id (never main, \
never force-push). (2) bd update $id --append-notes \"WIP: <bd/$id if pushed, else none> - <what \
is done, what you found out, the next step>\", then bd dolt push. Do not close, unclaim or block \
the issue. Then print RUN_WIP_SAVED on its own line and stop."
}

# Effective model: HERMES_ARGS (-m/--model, --provider) wins over config.yaml.
read -ra _args <<< "${HERMES_ARGS:-}"
_cfg() { # _cfg <key>  -> value, or warn on stderr (never silent)
  local v; v=$(hermes config get "$1" 2>/dev/null | tail -n1)
  [ -n "$v" ] || echo "warning: 'hermes config get $1' returned nothing" >&2
  printf '%s' "$v"
}
MODEL=$(_cfg model.default)
PROVIDER=$(_cfg model.provider)
for ((j = 0; j < ${#_args[@]}; j++)); do
  case "${_args[j]}" in
    -m|--model) MODEL=${_args[j+1]:-$MODEL} ;;
    --model=*) MODEL=${_args[j]#--model=} ;;
    --provider) PROVIDER=${_args[j+1]:-$PROVIDER} ;;
    --provider=*) PROVIDER=${_args[j]#--provider=} ;;
  esac
done
IMAGE=$(_cfg terminal.docker_image)
echo "== repo: $REPO | model: ${MODEL:-unknown} | provider: ${PROVIDER:-unknown} | sandbox: ${IMAGE:-default} | timeout: $TIMEOUT (+$EXTEND on progress, cap $EXTEND_CAP) | retry-on-timeout: $RETRY | max issues: $MAX"
if [ "$CLEAN" = 1 ]; then
  [ -n "$IMAGE" ] || { echo "clean: terminal.docker_image is not set, so the sandbox container cannot be found; not starting a run" >&2; exit 2; }
  hh_sandbox_reset "$IMAGE" "$NAME" "$LOG_DIR" || exit 2
fi

claimed_issue() { # <logfile> -> first issue id the run claimed, empty if none
  tr -d '\r' < "$1" | sed -n 's/.*bd update \([^ ]*\) --claim.*/\1/p' | head -n 1
}
existing_pr() { # <issue> -> URL of a PR from branch bd/<issue>, empty if none or gh fails
  [ -n "$1" ] || return 0
  gh pr list --repo "$REPO" --head "bd/$1" --state all --json url -q '.[0].url' 2>/dev/null | head -n 1
}
session_id() { # <logfile> -> Hermes session id from the exit footer ("Session:  <id>"), empty if none
  tr -d '\r' < "$1" | sed -n 's/^Session: *\([0-9A-Za-z_]*\)$/\1/p' | tail -n 1
}

# Release a claim left behind by a killed run so the next run can pick it up.
unclaim_stale() { # <logfile>
  [ "$UNCLAIM" = 1 ] || return 0
  local id
  id=$(claimed_issue "$1")
  [ -n "$id" ] || { echo "note: could not find a claimed issue id in $1"; return 0; }
  bd dolt pull >/dev/null 2>&1 || echo "warning: bd dolt pull failed; claim state may be stale"
  if bd list --status=in_progress 2>/dev/null | grep -q "$id"; then
    if bd unclaim "$id" >/dev/null 2>&1; then
      echo "released stale claim on $id"; bd dolt push >/dev/null 2>&1 || echo "warning: bd dolt push failed (unclaim is local only)"
    else echo "warning: bd unclaim $id failed"; fi
  else
    echo "note: $id is not in_progress in beads; nothing to release"
  fi
}

# One Hermes run. Sets: log, timed, status, class, run_start (YYYYMMDD_HHMMSS, to find the session).
run_once() { # <timeout> [session-id-to-resume [prompt]]   (a custom prompt = wrap-up: no extension)
  local stamp start end issue prompt=$PROMPT extend=$EXTEND cap=$EXTEND_CAP; local -a ps resume=()
  if [ -n "${2:-}" ]; then resume=(--resume "$2"); prompt=${3:-$RESUME_PROMPT}; fi
  if [ -n "${3:-}" ]; then extend=0; cap=$1; fi
  run_start=$(date +%Y%m%d_%H%M%S)
  stamp=$(date +%Y%m%d-%H%M%S)
  # two runs in the same second (a fast resume/retry) must not overwrite each other's log
  local n=1 base=$stamp
  while [ -e "$LOG_DIR/run-$stamp.log" ]; do n=$((n + 1)); stamp="$base-$n"; done
  log="$LOG_DIR/run-$stamp.log"; timed="$LOG_DIR/run-$stamp.timed.txt"
  echo "== run $i/$MAX | model: ${MODEL:-unknown} | timeout: $1 -> $log (timestamped: ${timed##*/})"
  start=$(date +%s)
  # Raw output goes to $log BEFORE the timestamp filter. SIGPIPE is ignored for
  # this pipeline so that if the filter ever dies, tee keeps writing the raw log
  # (and Hermes keeps running) instead of being killed by a broken pipe. BSD tee
  # then reports "Broken pipe" on every write, so its stderr goes to a file, not
  # the terminal. Degraded mode: no live terminal output until the run ends.
  local tee_err="$LOG_DIR/.tee-stderr"
  trap '' PIPE
  # shellcheck disable=SC2086  # HERMES_ARGS is intentionally word-split
  # --pass-session-id: Hermes sees its session id and writes `Hermes-Session:` in the PR.
  python3 -u "$WATCHDOG" --limit "$1" --extend "$extend" --cap "$cap" --log "$log" -- \
    hermes chat --pass-session-id ${resume[@]+"${resume[@]}"} ${HERMES_ARGS:-} -q "$prompt" 2>&1 \
    | tee "$log" 2>"$tee_err" | python3 -u "$HARNESS_HOME/lib/tsfilter.py" --log "$timed"
  ps=("${PIPESTATUS[@]}")
  trap - PIPE
  status=${ps[0]}; end=$(date +%s)
  if [ "${ps[2]}" != 0 ]; then
    echo "warning: timestamp filter failed (exit ${ps[2]}); live output stopped, the raw log still has everything: $log" >&2
  elif [ "${ps[1]}" != 0 ]; then
    echo "warning: tee failed writing the raw log (exit ${ps[1]}): $(head -n 1 "$tee_err" 2>/dev/null)" >&2
  fi
  rm -f "$tee_err"
  class=$(hermes_classify "$log" "$status")
  echo "RUN_RESULT=$class" | tee -a "$log"
  issue=$(claimed_issue "$log")
  RUN_TIME_LINE="RUN_TIME start=$(hh_hms "$start") end=$(hh_hms "$end") elapsed=$(hh_elapsed $((end - start))) issue=${issue:-unknown}"
  echo "$RUN_TIME_LINE"
  { hh_stamp_line "RUN_RESULT=$class"; hh_stamp_line "$RUN_TIME_LINE"; } >> "$timed" 2>/dev/null || true
  runs=$((runs + 1))
}

# An OK_DONE run whose bead lost its PR link (in_progress + URL in notes) is NOTES_LOST:
# hermes-review would refuse the PR and the queue would stall unnoticed. Read-only.
notes_check() {
  local claimed out rc
  claimed=$(claimed_issue "$log")
  [ -n "$claimed" ] || [ -z "$stopped_log" ] || claimed=$(claimed_issue "$stopped_log")
  out=$(hh_notes_check "$log" "$claimed"); rc=$?
  [ -n "$out" ] && printf '%s\n' "$out"
  [ "$rc" = 1 ] || return 0
  class=NOTES_LOST
  { printf '%s\n' "$out"; echo "RUN_RESULT=NOTES_LOST"; } >> "$log"
  hh_stamp_line "RUN_RESULT=NOTES_LOST" >> "$timed" 2>/dev/null || true
}

# The session of the run that just ended: its footer, else (killed or crashed, no footer) the
# harness session that started with it in Hermes' store.
run_session() { local s; s=$(session_id "$log"); [ -n "$s" ] || s=$(hh_find_session "$run_start"); printf '%s' "$s"; }

# A TIMEOUT or AGENT_CRASHED run leaves no PR. Resume its session for a short wrap-up that pushes
# WIP and appends a "WIP:" note (lib/wrapup.sh), so the next run starts from it, not from zero.
# The wrap-up gets its own log ending WRAPUP_OF=<failed log> and the failed run's RUN_RESULT;
# class is left as the failed run's class.
wrap_up() { # <log with the claim> [session id, when already known]
  local failed=$class failed_log=$log sid=${2:-} why
  case "$WRAPUP" in 0|0m|0s|'') return 0 ;; esac
  [ -n "$sid" ] || sid=$(run_session)
  [ -n "$sid" ] || { echo "note: no Hermes session found for $failed_log; cannot save its progress"; return 0; }
  case "$failed" in
    TIMEOUT) why="The run's time limit was reached." ;;
    *) why="Hermes crashed with an error (a crash) and this session was resumed after it." ;;
  esac
  echo "Run ended as $failed; resuming session $sid for a $WRAPUP wrap-up to save its progress."
  run_once "$WRAPUP" "$sid" "$(wrapup_prompt "$(claimed_issue "$1")" "$why")"
  if hh_wip_saved "$log"; then echo "Progress saved (RUN_WIP_SAVED); see the issue's WIP: note."
  else echo "warning: the wrap-up did not confirm RUN_WIP_SAVED (it ended as $class); progress may be lost. See $log"; fi
  { echo "WRAPUP_OF=$failed_log"; echo "RUN_RESULT=$failed"; } >> "$log"
  hh_stamp_line "RUN_RESULT=$failed" >> "$timed" 2>/dev/null || true
  class=$failed
}

# Save what a failed run did, then release its claim.
save_and_release() { # <log with the claim> [session id]
  case "$class" in TIMEOUT|AGENT_CRASHED) ;; *) return 0 ;; esac
  wrap_up "$@"
  unclaim_stale "$1"
}

final=OK_DONE
loop_start=$(date +%s); runs=0
for i in $(seq 1 "$MAX"); do
  stopped_log=""; sid=""
  run_once "$TIMEOUT"; claim_log=$log
  if [ "$class" = TIMEOUT ] && [ "$RETRY" = 1 ]; then
    cur=${TIMEOUT%m}; case "$cur" in ''|*[!0-9]*) cur=90 ;; esac
    bigger=$(( cur * 2 )); [ "$bigger" -gt "$TIMEOUT_CAP_MIN" ] && bigger=$TIMEOUT_CAP_MIN
    sid=$(run_session)
    if [ -n "$sid" ]; then
      # same session: it keeps everything it explored, and its claim
      echo "Timed out; retrying the issue once with ${bigger}m by resuming session $sid."
      run_once "${bigger}m" "$sid"
    else
      unclaim_stale "$log"
      echo "Timed out; retrying the issue once with ${bigger}m (no session found to resume)."
      run_once "${bigger}m"; claim_log=$log
    fi
  fi
  save_and_release "$claim_log" "$sid"
  # The agent ended its turn mid-issue (e.g. asked a question nobody will answer):
  # resume that same session once. Never twice: a second early stop ends the loop.
  # First ask GitHub: the agent may have opened the PR but never printed its URL.
  if [ "$class" = AGENT_STOPPED ]; then
    pr=$(existing_pr "$(claimed_issue "$log")")
    if [ -n "$pr" ]; then
      echo "A PR for the claimed issue already exists ($pr); counting the run as OK_DONE."
      class=OK_DONE; printf 'PR found by hermes-run: %s\nRUN_RESULT=OK_DONE\n' "$pr" >> "$log"
    fi
  fi
  if [ "$class" = AGENT_STOPPED ] && [ "$RESUME_ON_STOP" = 1 ]; then
    stopped_log=$log; sid=$(session_id "$log")
    if [ -n "$sid" ]; then
      echo "Agent ended its turn without a PR or a stop marker; resuming session $sid once."
      run_once "$TIMEOUT" "$sid"
      # the claim is in the first log, not the resumed one
      save_and_release "$stopped_log" "$sid"
    else
      echo "note: no session id in $log; cannot resume"
    fi
  fi
  [ "$class" = OK_DONE ] && notes_check
  final=$class
  case "$class" in
    OK_DONE) continue ;;
    NOTES_LOST) echo "The PR's bead lost its PR link (NOTES_CHECK lines above); hermes-review would refuse the PR — stopping. See $log"; break ;;
    QUEUE_EMPTY) echo "Queue empty."; final=QUEUE_EMPTY; break ;;
    BLOCKED) echo "Issue blocked — stopping. See $log"; break ;;
    MODEL_API_ERROR) echo "Agent made no progress (model/API error) — stopping. See $log"; break ;;
    TIMEOUT) echo "Run timed out — stopping. See $log"; break ;;
    AGENT_CRASHED) echo "Hermes crashed (traceback in the log) — stopping. See $claim_log"; break ;;
    AGENT_STOPPED) echo "Agent stopped mid-issue without a PR — stopping. Read the end of $log, then resume by hand: hermes --resume $(session_id "$log")"; break ;;
    *) echo "Run ended as $class — stopping. See $log"; break ;;
  esac
done
loop_end=$(date +%s)
echo "RUN_TIME total=$(hh_elapsed $((loop_end - loop_start))) start=$(hh_hms "$loop_start") end=$(hh_hms "$loop_end") runs=$runs"
echo "FINAL_RESULT=$final"
case "$final" in OK_DONE|QUEUE_EMPTY) exit 0 ;; *) exit 1 ;; esac
