#!/usr/bin/env bash
# hermes-status — READ-ONLY snapshot of the Hermes agent loop for the CURRENT repo.
#
# Usage: hermes-status [--tests]     (run from the target repo, or set HERMES_REPO)
#   --tests   also test origin/main in a throwaway worktree (cleaned up).
#             Default command: pytest in a fresh venv. Override with
#             HERMES_TEST_CMD="npm ci && npm test" (run inside the worktree).
#   -h, --help  show this help and exit (needs no repo)
# Env (all optional): HERMES_LOG_DIR HERMES_LOG_LINES=30 HERMES_PR_LIMIT=8 HERMES_REPO
#
# Never commits, pushes, pulls beads, or writes in the repo. Each section
# tolerates failure and prints "unavailable: <reason>".
set -uo pipefail
# Resolve symlinks (hermes-* are symlinked onto PATH), then locate the harness.
_s=${BASH_SOURCE[0]}
while [ -h "$_s" ]; do _d=$(cd "$(dirname "$_s")" && pwd); _s=$(readlink "$_s"); case $_s in /*) ;; *) _s="$_d/$_s" ;; esac; done
HARNESS_HOME=$(cd "$(dirname "$_s")/.." && pwd)
# shellcheck source=../lib/common.sh
. "$HARNESS_HOME/lib/common.sh"
# shellcheck source=../lib/busy.sh
. "$HARNESS_HOME/lib/busy.sh" # hh_active_procs: is a Hermes run active (test-suite runs excluded)
hh_help_requested "$@" && { hh_print_help "${BASH_SOURCE[0]}"; exit 0; }
hh_repo || exit 0
cd "$REPO_ROOT" || exit 0
LINES_N=${HERMES_LOG_LINES:-30}; PRS=${HERMES_PR_LIMIT:-8}
RUN_TESTS=0; [ "${1:-}" = "--tests" ] && RUN_TESTS=1
# shellcheck source=../lib/classify.sh
. "$HARNESS_HOME/lib/classify.sh"

hdr() { printf '\n== %s ==\n' "$1"; }
have() { command -v "$1" >/dev/null 2>&1; }
try() { # try <label> cmd...  : run, print "unavailable" on failure
  local label=$1; shift
  if ! "$@" 2>&1; then echo "unavailable: $label failed"; fi
}

hdr "repo: $REPO_ROOT"
hdr "origin/main"
if have git; then
  git fetch --quiet 2>/dev/null || echo "unavailable: git fetch failed (offline?)"
  try "git log" git log origin/main --oneline -n 8
else echo "unavailable: git not found"; fi

hdr "pull requests"
if have gh; then try "gh pr list" gh pr list --state all --limit "$PRS"; else echo "unavailable: gh not found"; fi

hdr "refused by hermes-review (at the PR's current commit)"
if have gh; then try "hermes-review --list-refused" "$HARNESS_HOME/bin/hermes-review" --list-refused
else echo "unavailable: gh not found"; fi

hdr "beads (local copy; not synced by this script)"
if have bd; then
  echo "-- ready"; try "bd ready" bd ready
  echo "-- in progress"; try "bd list" bd list --status=in_progress
  echo "-- blocked"; try "bd blocked" bd blocked
  echo "-- all"; try "bd list --all" bd list --all
else echo "unavailable: bd not found"; fi

hdr "active run"
procs=$(hh_active_procs pid,etime,command | cut -c1-140)
if [ -n "$procs" ]; then echo "RUNNING:"; echo "$procs"; ACTIVE=1; else echo "no hermes-run / hermes chat process"; ACTIVE=0; fi

hdr "latest log"
newest=$(ls -t "$LOG_DIR"/*.log 2>/dev/null | head -n 1)
if [ -n "$newest" ]; then
  age=$(( $(date +%s) - $(stat -f %m "$newest" 2>/dev/null || stat -c %Y "$newest" 2>/dev/null || date +%s) ))
  echo "file: $newest   last write: ${age}s ago"
  if [ "$ACTIVE" = 1 ] && [ "$age" -lt 1800 ]; then echo "class: RUNNING"; else echo "class: $(hermes_classify "$newest")"; fi
  # the loop stopped between runs because the harness code changed (bead eyx)
  stop=$(tr -d '\r' < "$newest" | sed -n 's/^LOOP_STOP=//p' | tail -n 1)
  [ -n "$stop" ] && echo "loop stopped: $stop"
  echo "-- last $LINES_N lines"; tail -n "$LINES_N" "$newest" | tr -d '\r'
else echo "unavailable: no logs in $LOG_DIR"; fi

if [ "$RUN_TESTS" = 1 ]; then
  hdr "tests on origin/main (throwaway worktree)"
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/hermes-status.XXXXXX")
  cleanup() { git worktree remove --force "$tmp/wt" >/dev/null 2>&1; rm -rf "$tmp"; git worktree prune >/dev/null 2>&1; }
  trap cleanup EXIT
  if git worktree add -q --detach "$tmp/wt" origin/main 2>/dev/null; then
    if [ -n "${HERMES_TEST_CMD:-}" ]; then
      ( cd "$tmp/wt" && bash -c "$HERMES_TEST_CMD" 2>&1 | tail -n 15 ) || echo "unavailable: test run failed"
    else
      ( cd "$tmp/wt" && python3 -m venv "$tmp/v" >/dev/null 2>&1 \
          && "$tmp/v/bin/pip" -q install pytest pytest-cov >/dev/null 2>&1 \
          && "$tmp/v/bin/python" -m pytest -q 2>&1 | tail -n 15 ) || echo "unavailable: test run failed"
    fi
  else echo "unavailable: could not create worktree"; fi
fi
exit 0
