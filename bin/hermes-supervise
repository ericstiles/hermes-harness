#!/usr/bin/env bash
# hermes-supervise — READ-ONLY diagnosis of the newest Hermes run in the CURRENT repo, with the
# recommended next action. Claude Code runs this, then acts on the action.
#
# Usage: hermes-supervise [<logfile> | --classify <logfile>]     (run from the target repo)
#   hermes-supervise                 diagnose newest log in $HERMES_LOG_DIR (default <repo>/logs)
#   hermes-supervise <logfile>       diagnose a specific log
#   hermes-supervise --classify <f>  print only the class name
#   -h, --help                       show this help and exit (needs no repo)
#
# Output (parseable): CLASS=..., ISSUE=..., ACTION=<AUTO_RELAUNCH|WAIT|DONE|ASK_HUMAN>,
# NEXT=<exact command to run>, then evidence lines.
#
# Remediation policy (Claude follows ACTION without asking, except ASK_HUMAN):
#   TIMEOUT          AUTO_RELAUNCH with doubled timeout (cap 120m). 2nd timeout on
#                    the same issue today, or a timeout that wrote no project file
#                    (it only explored) -> ASK_HUMAN "split the issue" (file a
#                    discovered-from issue, bd update --status blocked).
#   AGENT_CRASHED    Hermes died on an exception: AUTO_RELAUNCH (within the limit).
# After a TIMEOUT/AGENT_CRASHED, hermes-run's wrap-up log (WRAPUP_OF=<killed run's log>) is the
# newest log; the issue and the project-write check come from the killed run's log, and
# WIP_SAVED=yes|no says whether the wrap-up confirmed it saved the work.
#   SANDBOX_DOWN     AUTO_RELAUNCH after `colima start`.
#   BEADS_SYNC_ERROR AUTO_RELAUNCH after `bd dolt pull` (never force-push).
#   MODEL_API_ERROR  AUTO_RELAUNCH once Ollama answers; stop after 3 in a row.
#   QUEUE_EMPTY / OK_DONE  DONE / WAIT: nothing to do.
#   AUTH_ERROR / BLOCKED / UNKNOWN   ASK_HUMAN with evidence.
#   NOTES_LOST       ASK_HUMAN with the bd commands that restore the PR link.
# Hard limit: 3 automatic relaunches per issue per day (counted in
# <logs>/.relaunches, written by hermes-launch). Never prints GH_TOKEN.
set -uo pipefail
# Resolve symlinks (hermes-* are symlinked onto PATH), then locate the harness.
_s=${BASH_SOURCE[0]}
while [ -h "$_s" ]; do _d=$(cd "$(dirname "$_s")" && pwd); _s=$(readlink "$_s"); case $_s in /*) ;; *) _s="$_d/$_s" ;; esac; done
HARNESS_HOME=$(cd "$(dirname "$_s")/.." && pwd)
# shellcheck source=../lib/common.sh
. "$HARNESS_HOME/lib/common.sh"
hh_help_requested "$@" && { hh_print_help "${BASH_SOURCE[0]}"; exit 0; }
# shellcheck source=../lib/classify.sh
. "$HARNESS_HOME/lib/classify.sh"
# shellcheck source=../lib/wrapup.sh
. "$HARNESS_HOME/lib/wrapup.sh"
# shellcheck source=../lib/runtime.sh
. "$HARNESS_HOME/lib/runtime.sh" # hh_claimed_issue: the run's bead, as hermes-run reads it
MAX_RELAUNCH=3; TIMEOUT_CAP=120

if [ "${1:-}" = "--classify" ]; then hermes_classify "${2:?logfile}"; exit 0; fi
hh_repo || { echo "CLASS=UNKNOWN"; echo "ACTION=ASK_HUMAN"; echo "evidence: not inside a git repo"; exit 0; }
STATE="$LOG_DIR/.relaunches"          # lines: YYYYMMDD CLASS ISSUE

log=${1:-$(ls -t "$LOG_DIR"/*.log 2>/dev/null | head -n 1)}
[ -n "$log" ] && [ -r "$log" ] || { echo "CLASS=UNKNOWN"; echo "ACTION=ASK_HUMAN"; echo "evidence: no readable log in $LOG_DIR"; exit 0; }

active=$(ps -axo command 2>/dev/null | grep -E "$HH_ACTIVE_PATTERN" | grep -v grep | wc -l | tr -d ' ')
newest=$(ls -t "$LOG_DIR"/*.log 2>/dev/null | head -n 1)
if [ "$active" -gt 0 ] && [ "$log" = "$newest" ]; then class=RUNNING; else class=$(hermes_classify "$log"); fi

# a wrap-up log stands for the run it wrapped up
work_log=$log; wip=""
wrapped=$(tr -d '\r' < "$log" | sed -n 's/^WRAPUP_OF=//p' | tail -n 1)
if [ -n "$wrapped" ]; then
  if hh_wip_saved "$log"; then wip=yes; else wip=no; fi
  [ -r "$wrapped" ] && work_log=$wrapped
fi
issue=$(hh_claimed_issue "$work_log")
today=$(date +%Y%m%d)
count_today() { # <issue> [class]
  [ -f "$STATE" ] || { echo 0; return; }
  awk -v d="$today" -v i="$1" -v c="${2:-}" '$1==d && $3==i && (c=="" || $2==c){n++} END{print n+0}' "$STATE"
}
cur=${RUN_TIMEOUT:-90m}; cur=${cur%m}; case "$cur" in ''|*[!0-9]*) cur=90 ;; esac
next_to=$(( cur * 2 )); [ "$next_to" -gt "$TIMEOUT_CAP" ] && next_to=$TIMEOUT_CAP
relaunches=0; [ -n "$issue" ] && relaunches=$(count_today "$issue")

action=ASK_HUMAN; next=""; why=""
case "$class" in
  RUNNING)  action=WAIT; why="a run is in progress; check again in 20-30 min" ;;
  OK_DONE)  action=DONE; why="run finished and opened a PR; review/merge is the human's step" ;;
  QUEUE_EMPTY) action=DONE; why="no ready beads issues (bd dolt pull to confirm, then create issues)" ;;
  TIMEOUT)
    if [ -n "$issue" ] && [ "$(count_today "$issue" TIMEOUT)" -ge 2 ]; then
      why="issue $issue timed out twice today: split it (bd create ... --deps discovered-from:$issue), bd update $issue --status blocked, then relaunch"
    elif [ "$(hh_project_writes "$work_log")" = 0 ]; then
      why="issue ${issue:-unknown} timed out having written no project file and made no commit (it only explored), so a longer timeout is unlikely to help: read its WIP: note (bd show ${issue:-<id>}), split it (bd create ... --deps discovered-from:${issue:-<id>}), bd update ${issue:-<id>} --status blocked, then relaunch"
    elif [ "$relaunches" -ge "$MAX_RELAUNCH" ]; then why="relaunch limit ($MAX_RELAUNCH/day) reached for $issue"
    else action=AUTO_RELAUNCH; next="hermes-launch --reason TIMEOUT --issue ${issue:-unknown} --timeout ${next_to}m"
         why="killed by timeout before finishing; relaunch with ${next_to}m"; fi ;;
  SANDBOX_DOWN)
    if [ "$relaunches" -ge "$MAX_RELAUNCH" ]; then why="relaunch limit reached"
    else action=AUTO_RELAUNCH; next="colima start && hermes-launch --reason SANDBOX_DOWN --issue ${issue:-unknown}"; why="Docker/colima not running"; fi ;;
  BEADS_SYNC_ERROR)
    if [ "$relaunches" -ge "$MAX_RELAUNCH" ]; then why="relaunch limit reached"
    else action=AUTO_RELAUNCH; next="bd dolt pull && hermes-launch --reason BEADS_SYNC_ERROR --issue ${issue:-unknown}"; why="beads remote is ahead; pull then relaunch (never force-push)"; fi ;;
  MODEL_API_ERROR)
    if [ "$(awk '$2=="MODEL_API_ERROR"{n++} END{print n+0}' "$STATE" 2>/dev/null)" -ge 3 ]; then why="3 model/API failures in a row"
    else action=AUTO_RELAUNCH; next="curl -sf http://localhost:11434/api/tags >/dev/null && hermes-launch --reason MODEL_API_ERROR --issue ${issue:-unknown}"
         why="model server error; confirm Ollama answers, then relaunch"; fi ;;
  AGENT_CRASHED)
    exc=$(tr -d '\r' < "$work_log" | grep -E '^[A-Za-z_][A-Za-z0-9_.]*(Error|Exception|Exit)(: |$)' | tail -n 1)
    if [ "$relaunches" -ge "$MAX_RELAUNCH" ]; then why="Hermes crashed (${exc:-see the traceback}) and the relaunch limit ($MAX_RELAUNCH/day) is reached for $issue"
    else action=AUTO_RELAUNCH; next="hermes-launch --reason AGENT_CRASHED --issue ${issue:-unknown}"
         why="Hermes crashed: ${exc:-see the traceback}; relaunch (the next run continues from the issue's WIP: note)"; fi ;;
  TURN_LIMIT)
    stop=$(tr -d '\r' < "$work_log" | sed -n 's/^STOP_REASON: //p' | tail -n 1)
    why="issue ${issue:-unknown} used the session's whole tool-call budget (${stop:-Reached maximum iterations}) without a PR, so a relaunch would hit it again: read its WIP: note (bd show ${issue:-<id>}), split it (bd create ... --deps discovered-from:${issue:-<id>}), bd update ${issue:-<id>} --status blocked, then relaunch" ;;
  AUTH_ERROR) why="credentials problem (GH_TOKEN scope/expiry); needs the human" ;;
  BLOCKED)    why="Hermes marked the issue blocked and stopped; read its notes (bd show) and decide" ;;
  AGENT_STOPPED)
    sid=$(tr -d '\r' < "$log" | sed -n 's/^Session: *\([0-9A-Za-z_]*\)$/\1/p' | tail -n 1)
    why="agent ended its turn mid-issue with no PR and no RUN_BLOCKED (often: it asked a question nobody answers); hermes-run resumes once by default. Read the end of the log, then resume: hermes --resume ${sid:-<session id>} -q \"Continue the issue to its PR\" or release it: bd unclaim ${issue:-<id>}" ;;
  NOTES_LOST) # written by hermes-run from lib/notes_check.sh; never auto-repaired
    fixes=$(tr -d '\r' < "$log" | sed -n \
      -e 's/^NOTES_CHECK: \([^ ]*\) missing \([^ ]*\) in notes$/bd update \1 --append-notes "PR: \2"/p' \
      -e 's/^NOTES_CHECK: \([^ ]*\) status [^ ]*, expected in_progress$/bd update \1 --status in_progress/p' \
      | sort -u | paste -sd ';' - | sed 's/;/; /g')
    why="the run opened its PR but the bead lost its PR link, so hermes-review will refuse the PR. Check with bd show, then repair: ${fixes:-see the NOTES_CHECK lines}" ;;
  *)          why="unclassified; read the evidence" ;;
esac

echo "CLASS=$class"; echo "ISSUE=${issue:-unknown}"; echo "LOG=$log"
echo "ACTION=$action"; [ -n "$next" ] && echo "NEXT=$next"; echo "WHY=$why"
[ -n "$wip" ] && { echo "WIP_SAVED=$wip"; echo "WRAPUP_OF=$wrapped"; }
# the time-limit watchdog's last decision (EXTENDED / NO_PROGRESS / CAP_REACHED / TIME_LIMIT)
wd=$(tr -d '\r' < "$work_log" | grep '^WATCHDOG: ' | tail -n 1); [ -n "$wd" ] && echo "WATCHDOG=$wd"
echo "relaunches_today=$relaunches"
echo "--- evidence (last 12 lines, CR stripped)"; tail -n 12 "$log" | tr -d '\r' | sed 's/^/  /'
exit 0
